{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "C/C++: gcc.exe 调试活动文件",
      "type": "cppdbg",
      "request": "launch",
      "preLaunchTask": "C/C++: gcc.exe 生成活动文件",
      "args": [],
      "stopAtEntry": false,
      "externalConsole": false,
      "cwd": "${fileDirname}",
      "program": "${fileDirname}\\${fileBasenameNoExtension}.exe",
      "MIMode": "gdb",
      "miDebuggerPath": "D:/b/w64devkit/bin/gdb.exe",
